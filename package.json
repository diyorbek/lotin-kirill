{
  "name": "lotin-kirill",
  "version": "0.1.3",
  "description": "Transform Uzbek latin characters into Uzbek-cyrillic characters or vice versa. O'zbekcha so'zlarni lotin alifbosidan kirill alifbosiga (yoki aksincha) o'girish.",
  "author": "Diyorbek Sadullaev <diyorbek3377@gmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/diyorbek/lotin-kirill",
  "repository": {
    "type": "git",
    "url": "https://github.com/diyorbek/lotin-kirill.git"
  },
  "keywords": [
    "lotin",
    "kirill",
    "lotin-kirill",
    "alifbo",
    "transliteratsiya",
    "o'zbekcha"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "unpkg": "./dist/index.umd.js",
  "jsdelivr": "./dist/index.umd.js",
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "vite build && vite build --mode umd && tsc -p tsconfig.build.json",
    "typecheck": "tsc",
    "format": "biome check --write",
    "lint": "biome check",
    "test": "vitest run --coverage",
    "preversion": "npm run typecheck && npm run lint",
    "version": "npm run build",
    "postversion": "git push && git push --tags",
    "prepublishOnly": "npm run typecheck && npm run lint && npm run build"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^5.0.5",
    "husky": "^6.0.0",
    "np": "^7.5.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "anchorme": "^2.1.2"
  }
}
