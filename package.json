{
  "name": "lotin-kirill",
  "version": "1.1.0",
  "description": "Transliterate Uzbek text between the 1995 and 2026 Latin alphabets and Cyrillic. O'zbekcha matnni 1995 va 2026 yilgi lotin alifbolari hamda kirill alifbosi o'rtasida o'girish.",
  "author": "Diyorbek Sadullaev <diyorbek3377@gmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/diyorbek/lotin-kirill",
  "repository": {
    "type": "git",
    "url": "https://github.com/diyorbek/lotin-kirill.git"
  },
  "keywords": [
    "lotin",
    "kirill",
    "lotin-kirill",
    "alifbo",
    "transliteratsiya",
    "o'zbekcha"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./exceptions": {
      "types": "./dist/exceptions.d.ts",
      "import": "./dist/exceptions.js",
      "require": "./dist/exceptions.cjs"
    }
  },
  "typesVersions": {
    "*": {
      "exceptions": [
        "./dist/exceptions.d.ts"
      ]
    }
  },
  "unpkg": "./dist/index.umd.js",
  "jsdelivr": "./dist/index.umd.js",
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "vite build && vite build --mode umd && vite build --mode umd-exceptions && tsc -p tsconfig.build.json",
    "typecheck": "tsc",
    "format": "biome check --write",
    "lint": "biome check",
    "test": "vitest run --coverage",
    "preversion": "npm run typecheck && npm run lint",
    "version": "npm run build",
    "postversion": "git push && git push --tags",
    "prepublishOnly": "npm run typecheck && npm run lint && npm run build"
  },
  "np": {
    "message": "chore: Release %s"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^5.0.5",
    "lefthook": "^2.2.2",
    "np": "^12.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "anchorme": "^3.0.8"
  }
}
