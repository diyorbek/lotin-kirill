{
  "name": "lotin-kirill",
  "version": "0.1.3",
  "description": "Transform Uzbek latin characters into Uzbek-cyrillic characters or vice versa. O'zbekcha so'zlarni lotin alifbosidan kirill alifbosiga (yoki aksincha) o'girish.",
  "author": "Diyorbek Sadullaev <diyorbek3377@gmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/diyorbek/lotin-kirill",
  "repository": {
    "type": "git",
    "url": "https://github.com/diyorbek/lotin-kirill.git"
  },
  "keywords": [
    "lotin",
    "kirill",
    "lotin-kirill",
    "alifbo",
    "transliteratsiya",
    "o'zbekcha"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "unpkg": "./dist/index.umd.js",
  "jsdelivr": "./dist/index.umd.js",
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "vite build && vite build --mode umd && tsc --emitDeclarationOnly",
    "typecheck": "tsc --noEmit --skipLibCheck",
    "format": "prettier --write .",
    "lint": "eslint . --ext .ts",
    "test": "vitest run --coverage",
    "preversion": "npm run typecheck && npm run lint",
    "version": "npm run build",
    "postversion": "git push && git push --tags",
    "prepublishOnly": "npm run typecheck && npm run lint && npm run build"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^3.0.2",
    "@typescript-eslint/parser": "^3.0.2",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^7.1.0",
    "eslint-config-prettier": "^6.11.0",
    "eslint-plugin-prettier": "^3.1.3",
    "husky": "^6.0.0",
    "np": "^7.5.0",
    "prettier": "^2.2.1",
    "prettier-plugin-organize-imports": "^2.1.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "anchorme": "^2.1.2"
  }
}
